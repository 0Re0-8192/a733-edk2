## @file
# Recursively connect all handles so driver-binding modules loaded from the
# shell can actually start on existing controllers.
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = ConnectAll
  FILE_GUID                      = A733C011-0000-0000-0000-A733C0110001
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

[Sources]
  ConnectAll.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  MemoryAllocationLib
  DebugLib
  PrintLib

[Protocols]
  gEfiGraphicsOutputProtocolGuid
  gEfiSimpleTextOutProtocolGuid
