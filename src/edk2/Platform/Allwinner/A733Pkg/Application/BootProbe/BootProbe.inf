## @file
# Simple external EFI app to prove fs0: -> EFI app execution works.
##

[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = BootProbe
  FILE_GUID                      = A733B007-0000-0000-0000-A733B0070002
  MODULE_TYPE                    = UEFI_APPLICATION
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = UefiMain

[Sources]
  BootProbe.c

[Packages]
  MdePkg/MdePkg.dec

[LibraryClasses]
  UefiApplicationEntryPoint
  UefiLib
  UefiBootServicesTableLib
  PrintLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib

[Protocols]
  gEfiLoadedImageProtocolGuid
  gEfiSimpleFileSystemProtocolGuid
