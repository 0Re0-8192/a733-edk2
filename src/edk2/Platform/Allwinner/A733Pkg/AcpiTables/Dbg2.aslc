/** @file
 * Debug Port Table 2 (DBG2)
 * Allwinner A733 - UART0 debug port for Windows.
 *
 * This complements SPCR. SPCR describes the firmware console redirection
 * port, while DBG2 gives Windows an explicit debug-port description after
 * ExitBootServices.
 **/

#include "AcpiTables.h"
#include <IndustryStandard/DebugPort2Table.h>

#define UART0_BASE  0x02500000
#define UART0_SIZE  0x00000400

//
// DynamicTablesPkg's DBG2 generator emits "\_SB_.COM0" with a fixed 11-byte
// namespace field. Keep the static table byte-compatible with that layout.
//
#define DBG2_NAMESPACE_STRING_SIZE  11

#pragma pack(1)

typedef struct {
  EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE          Header;
  EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT    Device;
  EFI_ACPI_6_3_GENERIC_ADDRESS_STRUCTURE          BaseAddressRegister;
  UINT32                                          AddressSize;
  CHAR8                                           NameSpaceString[DBG2_NAMESPACE_STRING_SIZE];
} A733_DBG2_TABLE;

A733_DBG2_TABLE Dbg2 = {
  {
    {
      ACPI_HEADER (
        EFI_ACPI_6_3_DEBUG_PORT_2_TABLE_SIGNATURE,
        A733_DBG2_TABLE,
        EFI_ACPI_DEBUG_PORT_2_TABLE_REVISION
      )
    },
    sizeof (EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE),
    1
  },
  {
    EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT_REVISION,
    sizeof (A733_DBG2_TABLE) - sizeof (EFI_ACPI_DEBUG_PORT_2_DESCRIPTION_TABLE),
    1,
    DBG2_NAMESPACE_STRING_SIZE,
    sizeof (EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT) +
      sizeof (EFI_ACPI_6_3_GENERIC_ADDRESS_STRUCTURE) +
      sizeof (UINT32),
    0,
    0,
    EFI_ACPI_DBG2_PORT_TYPE_SERIAL,
    EFI_ACPI_DBG2_PORT_SUBTYPE_SERIAL_16550_WITH_GAS,
    { 0, 0 },
    sizeof (EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT),
    sizeof (EFI_ACPI_DBG2_DEBUG_DEVICE_INFORMATION_STRUCT) +
      sizeof (EFI_ACPI_6_3_GENERIC_ADDRESS_STRUCTURE)
  },
  {
    EFI_ACPI_6_3_SYSTEM_MEMORY,
    32,
    0,
    EFI_ACPI_6_3_DWORD,
    UART0_BASE
  },
  UART0_SIZE,
  "\\_SB_.COM0"
};

#pragma pack()

VOID *CONST ReferenceAcpiTable = &Dbg2;
